<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' lang='ar' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>
  <meta expr:content='data:blog.metaDescription' name='description'/>
  <b:if cond='data:blog.pageType == &quot;error_page&quot; or data:blog.pageType == &quot;archive&quot; or data:blog.searchQuery'>
    <meta content='noindex,follow' name='robots'/>
  </b:if>
  <meta content='#f7f5f0' name='theme-color'/>
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&amp;display=swap' rel='stylesheet'/>
  <script>//<![CDATA[
  try{if(localStorage.getItem('site-theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}
  //]]></script>
  <b:skin><![CDATA[
{{CSS}}
]]></b:skin>
</head>
<body>
  <a class='skip' href='#main-content'>تجاوز إلى المحتوى</a>
  <input aria-hidden='true' id='nav-t' tabindex='-1' type='checkbox'/>
  <header class='top'>
    <div class='wrap bar'>
      <label aria-label='فتح القائمة' class='icon-btn menu-btn' for='nav-t' role='button' tabindex='0'>{{I_MENU}}</label>
      <a class='brand' expr:href='data:blog.homepageUrl'><span class='mark' aria-hidden='true'></span>{{SITE}}</a>
      <nav aria-label='القائمة الرئيسية' class='nav'>
        <a expr:href='data:blog.homepageUrl + &quot;#games&quot;'>الألعاب</a>
        <a expr:href='data:blog.homepageUrl + &quot;#topics&quot;'>المعرفة</a>
        <a expr:href='data:blog.homepageUrl + &quot;#daily&quot;'>التحدي اليومي</a>
        <a href='/search?max-results=24'>المقالات</a>
      </nav>
      <div class='bar-end'>
        <details class='sdrop'><summary aria-label='بحث' class='icon-btn'>{{I_SEARCH}}</summary>
          <form action='/search' class='find' method='get' role='search'><label class='sr' for='q'>ابحث في الموقع</label><input id='q' name='q' placeholder='ابحث عن موضوع' type='search'/><button type='submit'>بحث</button></form>
        </details>
        <a aria-label='الحساب والتقدم' class='icon-btn' expr:href='data:blog.homepageUrl + &quot;#progress&quot;'>{{I_USER}}</a>
      </div>
    </div>
  </header>
  <label class='scrim' for='nav-t'></label>
  <aside aria-label='القائمة الجانبية' class='drawer'>
    <div class='dr-top'><span class='brand'><span class='mark' aria-hidden='true'></span>{{SITE}}</span><label aria-label='إغلاق القائمة' class='icon-btn' for='nav-t' role='button' tabindex='0'>{{I_CLOSE}}</label></div>
    <nav aria-label='القائمة الجانبية'>
      <a expr:href='data:blog.homepageUrl + &quot;#games&quot;'>الألعاب</a>
      <a expr:href='data:blog.homepageUrl + &quot;#daily&quot;'>التحدي اليومي</a>
      <a expr:href='data:blog.homepageUrl + &quot;#topics&quot;'>أقسام المعرفة</a>
      <a href='/search?max-results=24'>المقالات</a>
      <a expr:href='data:blog.homepageUrl + &quot;#progress&quot;'>التقدم والحساب</a>
      {{DR_ABOUT}}
    </nav>
    <button class='btn-quiet js-theme' type='button'>الوضع الداكن</button>
  </aside>

  <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
    <b:widget id='Blog1' locked='true' title='المحتوى' type='Blog' version='2'>
      <b:widget-settings>
        <b:widget-setting name='showDateHeader'>false</b:widget-setting>
        <b:widget-setting name='showShareButtons'>false</b:widget-setting>
        <b:widget-setting name='showCommentLink'>false</b:widget-setting>
      </b:widget-settings>
      <b:includable id='main' var='top'>
<main id='main-content'>
<b:if cond='data:blog.url == data:blog.homepageUrl'>
{{HOME}}
<b:elseif cond='data:blog.pageType == &quot;error_page&quot;'/>
{{ERROR}}
<b:elseif cond='data:blog.pageType == &quot;item&quot;'/>
{{ITEM}}
<b:elseif cond='data:blog.pageType == &quot;static_page&quot;'/>
{{STATIC}}
<b:else/>
{{LISTING}}
</b:if>
</main>
      </b:includable>
    </b:widget>
  </b:section>

  <footer class='foot'>
    <div class='wrap'>
      <div class='foot-grid'>
        <div><div class='foot-brand'>{{SITE}}</div><p>معلومات موثّقة وألعاب أسئلة بالعربية، تعمل بلا تسجيل.</p></div>
        <div><h4>أقسام المعرفة</h4><ul>{{FOOT_TOPICS}}</ul></div>
        <div><h4>عن الموقع</h4><ul>{{FOOT_ABOUT}}</ul></div>
      </div>
      <div class='foot-end'><span>© {{SITE}}</span><button class='btn-quiet js-theme' type='button'>الوضع الداكن</button></div>
    </div>
  </footer>
  <script>//<![CDATA[
{{JS}}
  //]]></script>
</body>
</html>
