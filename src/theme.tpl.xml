<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' lang='ar' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='IE=edge' http-equiv='X-UA-Compatible'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>
  <meta expr:content='data:blog.metaDescription' name='description'/>
  <b:if cond='data:blog.pageType == &quot;error_page&quot; or data:blog.pageType == &quot;archive&quot; or data:blog.searchQuery'>
    <meta content='noindex,follow' name='robots'/>
  <b:else/>
    <meta content='index,follow,max-image-preview:large' name='robots'/>
  </b:if>
  <meta expr:content='data:blog.pageType' name='dq-pagetype'/>
  <meta content='#f6f2ea' name='theme-color'/>
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800&amp;family=Noto+Naskh+Arabic:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>
  <script type='application/ld+json'>
  {"@context":"https://schema.org","@type":"WebSite","name":"BASIRA | بصيرة","alternateName":"BASIRA","inLanguage":"ar","description":"فكّر. اكتشف. العب. منصة عربية للمعرفة والأدوات والتحديات."}}
  </script>
  <script>//<![CDATA[
  try{if(localStorage.getItem('basira-theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}
  //]]></script>
{{HEAD_SCRIPTS}}
  <b:skin><![CDATA[
{{CSS}}
]]></b:skin>
</head>
<body>
  <a class='skip' href='#main-content'>تجاوز إلى المحتوى</a>
  <input aria-hidden='true' id='nav-t' tabindex='-1' type='checkbox'/>
  <header class='top'>
    <div class='wrap bar'>
      <a class='brand' expr:href='data:blog.homepageUrl'>BASIRA <small>بصيرة · فكّر. اكتشف. العب.</small></a>
      <nav aria-label='القائمة الرئيسية' class='nav'>
        <a href='/p/tools.html'>الأدوات</a>
        <a expr:href='data:blog.homepageUrl + &quot;search?max-results=24&quot;'>المقالات</a>
        <a href='/p/about.html'>عن بصيرة</a>
      </nav>
      <div class='nav-wrap'>
        <button aria-label='تبديل الوضع الداكن' class='iconbtn' id='theme-toggle' type='button'>الوضع</button>
        <label class='iconbtn burger' for='nav-t'>القائمة</label>
      </div>
    </div>
  </header>
  <div class='today'><div class='wrap'><b>اليوم</b><span data-today='g'></span><span data-today='h'></span></div></div>

  <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
    <b:widget id='Blog1' locked='true' title='المحتوى' type='Blog' version='2'>
      <b:widget-settings>
        <b:widget-setting name='showDateHeader'>false</b:widget-setting>
        <b:widget-setting name='showShareButtons'>false</b:widget-setting>
        <b:widget-setting name='showCommentLink'>false</b:widget-setting>
      </b:widget-settings>
      <b:includable id='main' var='top'>
<main id='main-content'>
<b:if cond='data:blog.url == data:blog.homepageUrl'>
{{HOME}}
<b:elseif cond='data:blog.pageType == &quot;error_page&quot;'/>
{{ERROR}}
<b:elseif cond='data:blog.pageType == &quot;item&quot;'/>
{{ITEM}}
<b:elseif cond='data:blog.pageType == &quot;static_page&quot;'/>
{{STATIC}}
<b:else/>
{{LISTING}}
</b:if>
</main>
      </b:includable>
    </b:widget>
  </b:section>

  <footer class='foot'>
    <div class='wrap'>
      <div class='fg'>
        <div><div class='b'>BASIRA | بصيرة</div><p>فكّر. اكتشف. العب. منصة عربية تجمع المعرفة والأدوات والتحديات.</p></div>
        <div><h4>التواريخ والوقت</h4><ul>{{FOOT_A}}</ul></div>
        <div><h4>الأرقام والوحدات</h4><ul>{{FOOT_B}}</ul></div>
        <div><h4>عن الموقع</h4><ul><li><a href='/p/about.html'>عن بصيرة</a></li><li><a href='/p/editorial-policy.html'>سياسة التحرير</a></li><li><a href='/p/contact.html'>اتصل بنا</a></li><li><a href='/p/privacy-policy.html'>سياسة الخصوصية</a></li><li><a href='/p/terms.html'>شروط الاستخدام</a></li></ul></div>
      </div>
      <div class='fb'><span>© BASIRA | بصيرة — جميع الحقوق محفوظة</span><span>الأدوات للإرشاد والتخطيط، وليست استشارة قانونية أو مالية أو دينية.</span></div>
    </div>
  </footer>
  <script>//<![CDATA[
{{CORE}}
{{APP}}
  //]]></script>
</body>
</html>
