<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' lang='ar' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>
  <link href='https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&amp;display=swap' rel='stylesheet'/>
  <script>//<![CDATA[
  try{if(localStorage.getItem('site-theme')==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}
  //]]></script>
  <b:skin><![CDATA[
{{CSS}}
]]></b:skin>
</head>
<body>
  <a class='skip' href='#content'>تجاوز إلى المحتوى</a>
  <header class='top'>
    <div class='wrap bar'>
      <a class='brand' expr:href='data:blog.homepageUrl'>{{LOGO}}<span>BASIRA | بصيرة</span></a>
      <nav aria-label='القائمة الرئيسية' class='nav'>
        <a expr:href='data:blog.homepageUrl + &quot;#play&quot;'>الألعاب</a>
        <a expr:href='data:blog.homepageUrl + &quot;#topics&quot;'>المعرفة</a>
        <a href='/search?max-results=24'>المقالات</a>
      </nav>
    </div>
  </header>

  <b:if cond='data:blog.url == data:blog.homepageUrl'>
{{HOME}}
  </b:if>

  <div class='wrap content' id='content'>
    <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
      <b:widget id='Blog1' locked='true' title='مشاركات المدونة' type='Blog' version='2' visible='true'>
        <b:includable id='main' var='top'>
          <b:loop values='data:posts' var='post'>
            <article class='post'>
              <b:if cond='data:blog.pageType == &quot;item&quot; or data:blog.pageType == &quot;static_page&quot;'>
                <h1><data:post.title/></h1>
                <data:post.body/>
              <b:else/>
                <h2><a expr:href='data:post.url'><data:post.title/></a></h2>
                <data:post.snippet/>
              </b:if>
            </article>
          </b:loop>
          <div class='pager'>
            <b:if cond='data:newerPageUrl'><a expr:href='data:newerPageUrl'>الأحدث</a></b:if>
            <b:if cond='data:olderPageUrl'><a expr:href='data:olderPageUrl'>الأقدم</a></b:if>
          </div>
        </b:includable>
      </b:widget>
    </b:section>
  </div>

  <footer class='foot'>
    <div class='wrap'>
      <div class='foot-grid'>
        <div><p>معلومات موثّقة وألعاب أسئلة بالعربية، تعمل بلا تسجيل.</p></div>
        <div><h4>أقسام المعرفة</h4><ul>{{FOOT_TOPICS}}</ul></div>
        <div><h4>عن الموقع</h4><ul>{{FOOT_ABOUT}}</ul></div>
      </div>
      <div class='foot-end'><span>© BASIRA</span><button class='btn-quiet js-theme' type='button'>الوضع الداكن</button></div>
    </div>
  </footer>
  <script>//<![CDATA[
{{JS}}
  //]]></script>
</body>
</html>
