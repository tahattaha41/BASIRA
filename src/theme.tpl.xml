<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' lang='ar' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>
  <meta content='BASIRA | بصيرة' property='og:site_name'/>
  <meta expr:content='data:blog.pageTitle' property='og:title'/>
  <meta expr:content='data:blog.metaDescription' property='og:description'/>
  <meta expr:content='data:blog.canonicalUrl' property='og:url'/>
  <meta content='website' property='og:type'/>
  <meta content='summary' name='twitter:card'/>
  <meta expr:content='data:blog.pageTitle' name='twitter:title'/>
  <meta expr:content='data:blog.metaDescription' name='twitter:description'/>
  <meta content='#a88b54' name='theme-color'/>
  <meta content='yes' name='apple-mobile-web-app-capable'/>
  <link href='data:application/manifest+json,%7B%22name%22%3A%22BASIRA%20%7C%20%D8%A8%D8%B5%D9%8A%D8%B1%D8%A9%22%2C%22short_name%22%3A%22BASIRA%22%2C%22start_url%22%3A%22%2F%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%23f6f3eb%22%2C%22theme_color%22%3A%22%23a88b54%22%2C%22lang%22%3A%22ar%22%2C%22dir%22%3A%22rtl%22%7D' rel='manifest'/>
  <b:if cond='data:view.isSingleItem'>
    <script type='application/ld+json'>{"@context":"https://schema.org","@type":"Article","headline":"<data:blog.pageName/>","description":"<data:blog.metaDescription/>","mainEntityOfPage":"<data:blog.canonicalUrl/>","publisher":{"@type":"Organization","name":"BASIRA | بصيرة"}}</script>
  </b:if>
  <b:if cond='data:view.isHomepage'>
  <script type='application/ld+json'>{"@context":"https://schema.org","@type":"WebSite","name":"BASIRA | بصيرة","url":"<data:blog.homepageUrl/>","potentialAction":{"@type":"SearchAction","target":"<data:blog.homepageUrl/>search?q={q}","query-input":"required name=q"}}</script>
  </b:if>
  <link href='https://fonts.googleapis.com/css2?family=Noto+Sans+Arabic:wght@400;600;700&amp;family=Inter:wght@400;600;700&amp;display=swap' rel='stylesheet'/>
  <script>//<![CDATA[
  (function(){var d=document.documentElement;try{var pr=localStorage.getItem('site-theme');if(pr!=='light'&&pr!=='auto')pr='dark';d.setAttribute('data-pref',pr);d.setAttribute('data-theme',pr==='auto'?(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark'):pr);}catch(e){d.setAttribute('data-theme','dark');}try{
  var m=/[?&]lang=(en|ar)/.exec(location.search),l=m?m[1]:localStorage.getItem('basira.lang');
  if(l==='en'){d.setAttribute('lang','en');d.setAttribute('dir','ltr');}}catch(e){}})();
  //]]></script>
  <link href='https://cdn.jsdelivr.net/gh/tahattaha41/BASIRA@main/dist/basira.css' rel='stylesheet'/>
  <b:skin><![CDATA[/* BASIRA styles load from the public GitHub build asset. */]]></b:skin>
</head>
<body>
  <a class='skip' data-i='skip' href='#content'>تجاوز إلى المحتوى</a>
  <header class='top'>
    <div class='wrap bar'>
      <a class='brand' expr:href='data:blog.homepageUrl'>{{LOGO}}<span>BASIRA | بصيرة</span></a>
      <form action='/search' class='find' method='get' role='search'>
        <label class='sr' data-i='search.label' for='q'>{{ar:search.label}}</label>
        <input data-ip='search.ph' id='q' name='q' placeholder='{{ar:search.ph}}' type='search'/>
        <button data-i='search.btn' type='submit'>{{ar:search.btn}}</button>
      </form>
      <div class='bar-end'>
        <button class='btn-quiet js-lang' data-i='lang.switch' type='button'>English</button>
        <button class='btn-quiet js-theme' type='button'>المظهر: داكن</button>
      </div>
      <nav aria-label='main' class='nav'>
        <a data-i='nav.games' expr:href='data:blog.homepageUrl + &quot;#play&quot;'>{{ar:nav.games}}</a>
        <a data-i='nav.topics' expr:href='data:blog.homepageUrl + &quot;#topics&quot;'>{{ar:nav.topics}}</a>
        <a data-i='nav.articles' href='/search?max-results=24'>{{ar:nav.articles}}</a>
        {{NAV_VERIFY}}
      </nav>
    </div>
  </header>

  <b:if cond='data:view.isHomepage'>
{{HOME}}
  </b:if>

  <div class='wrap content' id='content'>
    <b:section class='main' id='main' maxwidgets='1' showaddelement='no'>
      <b:widget id='Blog1' locked='true' title='مشاركات المدونة' type='Blog' version='2' visible='true'>
        <b:includable id='main' var='top'>
          <b:if cond='data:view.isHomepage'><h2 class='sec-h' data-i='latest.title'>{{ar:latest.title}}</h2></b:if>
          <b:if cond='data:view.isHomepage'>
            <div class='article-grid'>
              <b:loop values='data:posts' var='post'>
                <article class='post article-card'>
                  <span class='article-kicker'>BASIRA · <data:post.date/></span>
                  <h2><a expr:href='data:post.url'><data:post.title/></a></h2>
                  <p><data:post.snippet/></p>
                  <a class='article-read' expr:href='data:post.url'>اقرأ المقال ←</a>
                </article>
              </b:loop>
            </div>
          <b:else/>
            <b:loop values='data:posts' var='post'>
              <article class='post'>
                <b:if cond='data:view.isSingleItem'>
                  <h1><data:post.title/></h1>
                  <data:post.body/>
                <b:else/>
                  <h2><a expr:href='data:post.url'><data:post.title/></a></h2>
                  <p class='meta'><data:post.date/></p>
                  <data:post.snippet/>
                </b:if>
              </article>
            </b:loop>
          </b:if>
          <div class='pager'>
            <b:if cond='data:newerPageUrl'><a expr:href='data:newerPageUrl'>«</a></b:if>
            <b:if cond='data:olderPageUrl'><a expr:href='data:olderPageUrl'>»</a></b:if>
          </div>
        </b:includable>
      </b:widget>
    </b:section>
  </div>

  <footer class='foot'>
    <div class='wrap'>
      <div class='foot-grid'>
        <div><p data-i='foot.note'>{{ar:foot.note}}</p></div>
        <div><h4 data-i='foot.topics'>{{ar:foot.topics}}</h4><ul>{{FOOT_TOPICS}}</ul></div>
        <div><h4 data-i='foot.about'>{{ar:foot.about}}</h4><ul>{{FOOT_ABOUT}}</ul></div>
      </div>
      <div class='foot-end'><span>© 2026 BASIRA | بصيرة — Created by Taha Omar · إنشاء وتطوير: طه عمر</span><a class='admin-entry' href='https://www.blogger.com/' target='_blank' rel='noopener noreferrer'><span data-i='admin.link'>إدارة الموقع</span></a></div>
    </div>
  </footer>
  <script src='https://cdn.jsdelivr.net/gh/tahattaha41/BASIRA@main/dist/basira.js'></script>
</body>
</html>
